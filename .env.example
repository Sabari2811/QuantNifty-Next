# Local QuantNifty runtime configuration — NEVER commit real values.
# Copy this file to .env.local and fill in your own credentials.
INDSTOCKS_API_TOKEN=

# GPT-6 Astra decision intelligence. Keep the API key out of git.
# Astra is a live-market advisory precision layer; real trading remains disabled.
OPENAI_API_KEY=
ASTRA_ENABLED=true
ASTRA_MODEL=gpt-6-astra
ASTRA_REASONING_EFFORT=medium
ASTRA_MIN_CONFIDENCE=70
ASTRA_TIMEOUT_SECONDS=8
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

# Optional: pin a known NIFTY expiry (YYYY-MM-DD). Leave blank to resolve the next expiry.
NIFTY_EXPIRY=
NIFTY_SECURITY_ID=40000001
NIFTY_SCRIP_CODE=NSE_40000001
POLL_SECONDS=15

# Recommended for live-validation durability: Render Postgres external connection string.
# Get the External Database URL from Render Dashboard > quantnifty-learning > Connect.
# The application forces sslmode=require, so do not disable TLS.
DATABASE_URL=

# Local filesystem fallback only; PostgreSQL is preferred for validation.
QUANTNIFTY_LEARNING_ROOT=.quantnifty-learning
